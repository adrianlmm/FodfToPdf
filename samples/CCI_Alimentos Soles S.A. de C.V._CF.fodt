   <text:p text:style-name="P30" loext:marker-style-name="T21"><text:soft-page-break/><text:span text:style-name="T20">CONSENTIMIENTO PARA QUE EL PAGO SEA POR TARJETA BANCARIA</text:span><text:span text:style-name="T20"/></text:p>
   <text:p text:style-name="P18" loext:marker-style-name="T2"/>
   <text:p text:style-name="P31" loext:marker-style-name="T2"/>
   <text:p text:style-name="P32" loext:marker-style-name="T21"><text:span text:style-name="T21">Por </text:span><text:span text:style-name="T22">medio</text:span><text:span text:style-name="T21"> de la presente otorgo mi consentimiento para que si esta empresa deseara pagar mis </text:span><text:span text:style-name="T22">salarios</text:span><text:span text:style-name="T21"> y cualesquier otra</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">prestación </text:span><text:span text:style-name="T24"><text:s/></text:span><text:span text:style-name="T21">por</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">medio de</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">DEPOSITO</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">BANCARIO,</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">y</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">si</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">necesitare</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">abrir </text:span><text:span text:style-name="T24"><text:s/></text:span><text:span text:style-name="T21">la</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">cuenta</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">correspondiente,</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">sin</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">importar</text:span><text:span text:style-name="T23"> </text:span><text:span text:style-name="T21">la institución</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">bancaria</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">que </text:span><text:span text:style-name="T26"><text:s/></text:span><text:span text:style-name="T21">la</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">empresa</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">decida,</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">manifiesto</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">mi</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">conformidad,</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">lisa</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">y</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">llana</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">para </text:span><text:span text:style-name="T26"><text:s/></text:span><text:span text:style-name="T21">firmar</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">la</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">documentación</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T21">que para</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">este</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">fin</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">sea</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">requerida</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">y</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">desde <text:s text:c="4"/>luego</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">para</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">que</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">así</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">se</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">me</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">cubra</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">el</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">salario</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">y/o</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">prestaciones</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">derivadas</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">de</text:span><text:span text:style-name="T27"> </text:span><text:span text:style-name="T21">la prestación de servicios.</text:span></text:p>
