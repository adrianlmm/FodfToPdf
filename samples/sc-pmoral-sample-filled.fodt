     <table:table-cell table:style-name="Tabla2.A43" table:number-columns-spanned="13" office:value-type="string">
      <text:p text:style-name="P25"><text:span text:style-name="T13"><text:span text:style-name="T13">Juan Carlos Pérez López</text:span></text:span><text:span text:style-name="T14"><text:s /></text:span><text:span text:style-name="T13"><text:span text:style-name="T13">Dato de ejemplo</text:span></text:span><text:span text:style-name="T14"><text:s /></text:span><text:span text:style-name="T13"><text:span text:style-name="T13">Dato de ejemplo</text:span></text:span></text:p>
