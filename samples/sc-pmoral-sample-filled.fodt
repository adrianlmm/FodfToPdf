     <table:table-cell table:style-name="Tabla2.A43" table:number-columns-spanned="10" office:value-type="string">
      <text:p text:style-name="P26">NOMBRE Y AUTOGRAFA DEL REPRESENTANTE LEGAL</text:p>
     </table:table-cell>
     <table:covered-table-cell />
     <table:covered-table-cell />
     <table:covered-table-cell />
     <table:covered-table-cell />
     <table:covered-table-cell />
     <table:covered-table-cell />
     <table:covered-table-cell />
