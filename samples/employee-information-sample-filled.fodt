      <text:p text:style-name="P4"><text:span text:style-name="T5">NOMBRE(S):</text:span><text:span text:style-name="T6">  </text:span><text:bookmark-start text:name="Nombres" /><text:span text:style-name="T6">Misael de Jesús</text:span><text:bookmark-end text:name="Nombres" /></text:p>
      <text:p text:style-name="P4"><text:span text:style-name="T6"><text:line-break /></text:span><text:span text:style-name="T5">A. PATERNO:</text:span><text:span text:style-name="T7"> <text:s /></text:span><text:bookmark-start text:name="ApellidoP" /><text:span text:style-name="T7">Ontiveros</text:span><text:bookmark-end text:name="ApellidoP" /><text:span text:style-name="T5">A. MATERNO:</text:span><text:span text:style-name="T7"> </text:span><text:bookmark-start text:name="ApellidoM" /><text:span text:style-name="T7">Rodríguez</text:span><text:bookmark-end text:name="ApellidoM" /></text:p>
