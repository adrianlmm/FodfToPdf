<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generador de PDF con PrawnSharp (PDFsharp 6.2.4 MIT) para FodtToPdf.
    Controla directamente métricas TTF/OTF, cuantización en twips, línea base,
    cortes de línea y división de filas de tabla para igualar a LibreOffice Writer.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FodtToPdf</RootNamespace>
    <AssemblyName>FodtToPdf.PrawnSharp</AssemblyName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FodtToPdf\FodtToPdf.csproj" />
    <ProjectReference Include="..\PrawnSharp\src\PrawnSharp\PrawnSharp.csproj" />
    <ProjectReference Include="..\PrawnSharp\src\PrawnSharp.Abstractions\PrawnSharp.Abstractions.csproj" />
    <ProjectReference Include="..\PrawnSharp\src\PrawnSharp.Backend.PdfSharp\PrawnSharp.Backend.PdfSharp.csproj" />
  </ItemGroup>

</Project>
