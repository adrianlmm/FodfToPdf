<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Núcleo de FodtToPdf: edición de plantillas .fodt y punto de entrada de conversión a PDF
    (generador en proceso registrado por FodtToPdf.PrawnSharp, con respaldo a LibreOffice).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FodtToPdf</RootNamespace>
    <AssemblyName>FodtToPdf</AssemblyName>
      <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
  </PropertyGroup>

</Project>
